{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "helpers:pinGitHubActionDigests"],
  schedule: ["before 6am on monday"],
  timezone: "Europe/Vienna",
  labels: ["dependencies"],
  // Gives a hijacked release time to be noticed and pulled before it reaches a PR.
  minimumReleaseAge: "3 days",
  lockFileMaintenance: { enabled: true, schedule: ["before 6am on monday"] },
  customManagers: [
    {
      // Qt, aqtinstall, pdfium and ONNX Runtime builds, marked with a `renovate:` comment above them.
      customType: "regex",
      managerFilePatterns: [
        "/^\\.github/actions/.+\\.yml$/",
        "/^build-aux/fetch-pdfium\\.sh$/",
        "/^build-aux/fetch-onnxruntime\\.sh$/",
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[^\\n]*?[:=]\\s*"?(?<currentValue>[0-9][^"\\s]*)"?',
      ],
    },
  ],
  packageRules: [
    {
      // One PR a week for everything that should not break anything.
      matchUpdateTypes: ["minor", "patch", "digest"],
      groupName: "non-major dependencies",
    },
    {
      // The bridge's build and runtime halves must be the same release.
      matchPackageNames: ["cxx-qt", "cxx-qt-lib", "cxx-qt-build"],
      groupName: "cxx-qt",
    },
    {
      // Pinned to the cxx-gen that cxx-qt uses; it moves by hand together with cxx-qt.
      matchPackageNames: ["cxx", "cxx-build", "/^cxxbridge-/"],
      enabled: false,
    },
    {
      // Pinned to the typed-path whose TypedPath onenote_parser takes; it moves by hand together with onenote_parser.
      matchPackageNames: ["typed-path"],
      enabled: false,
    },
    {
      // androiddeployqt of Qt 6.10 builds with Gradle 8.14, and the 9.x plugin needs Gradle 9.
      // Android builds only run on pushes, so a PR's checks can't catch this.
      matchPackageNames: ["com.android.tools.build:gradle"],
      allowedVersions: "<9",
    },
    {
      // androidx.core 1.17 and newer need a compileSdk above the android-35 the APK builds against.
      matchPackageNames: ["androidx.core:core"],
      allowedVersions: "<1.17",
    },
    {
      matchPackageNames: ["microsoft/onnxruntime"],
      extractVersion: "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
    },
    {
      // ort loads the ONNX Runtime library at runtime and needs at least the release it binds.
      matchPackageNames: ["ort", "microsoft/onnxruntime"],
      groupName: "onnxruntime",
      prBodyNotes: [
        "The checksums in `build-aux/fetch-onnxruntime.sh` need updating by hand: download each platform's archive for the new release and put its SHA-256 in. CI fails until then.",
      ],
    },
    {
      // tylax writes Typst for the typst version it was built against.
      matchPackageNames: ["typst", "/^typst-/", "tylax"],
      groupName: "typst",
    },
    {
      // Pixmaps pass between them, so they must share one tiny-skia.
      matchPackageNames: ["resvg", "tiny-skia", "ttf-parser"],
      groupName: "resvg",
    },
    {
      // The Flatpak's KDE runtime is Qt 6.10; a new minor Qt moves with the runtime, by hand.
      matchPackageNames: ["qt/qtbase"],
      extractVersion: "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
      allowedVersions: "<6.11",
      groupName: "Qt",
    },
    {
      // Its tag names the KDE runtime, which changes together with Qt.
      matchPackageNames: ["ghcr.io/flathub-infra/flatpak-github-actions"],
      enabled: false,
    },
    {
      matchPackageNames: ["bblanchon/pdfium-binaries"],
      extractVersion: "^chromium/(?<version>\\d+)$",
      versioning: "loose",
    },
    {
      // pdfium-render binds the newest pdfium API it knows, so the library follows it.
      matchPackageNames: ["pdfium-render", "bblanchon/pdfium-binaries"],
      groupName: "pdfium",
      prBodyNotes: [
        "The checksums in `build-aux/fetch-pdfium.sh` need updating by hand: download each platform's archive for the new build and put its SHA-256 in. CI fails until then.",
      ],
    },
  ],
}
