# Handwriting becomes a formula or text (a stand-in recognizer reads every line); without a
# downloaded model, Settings opens at the download, where reading for search is still off.
# env: DUCTUS_MODELS_DIR=target/ui-no-models
size 1280 800
setenv DUCTUS_TEST_RECOGNIZER \[\frac{1}{2}\]
pen p=0.6 420,300 440,280 460,310 480,285 500,305
click-item tab_draw
click-item toolLasso
pen 400,260 560,260 560,330 400,330 400,260
expect-prop canvas selectionCount 1
# The pen taps the bar above the page, not the page below it.
pen-tap selectionToMath
wait 500
expect-in-file My Notebook/First page.svg | dx:src="\frac{1}{2}"
# The result opens in its editor, to correct a misreading right away.
expect-prop mathEditor visible true
expect-prop mathSource text \frac{1}{2}
key Escape
key Ctrl+Z
expect-prop canvas canRedo true
setenv DUCTUS_TEST_RECOGNIZER Grenzwert
click-item pageToText
wait 500
expect-in-file My Notebook/First page.svg | Grenzwert
type e
key Escape
expect-in-file My Notebook/First page.svg | Grenzwerte
key Ctrl+Z
setenv DUCTUS_TEST_RECOGNIZER
click-item pageToText
expect-prop model_text visible true
expect-prop hwrSearchSwitch checked false
# Each chosen language brings the reader for its script into the downloads.
click-item hwrLangSearch
type rus
click-item hwrLang_ru
expect-prop model_text-eslav visible true
