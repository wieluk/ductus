# New pages open in new tabs; a sidebar click uses the preview tab, Open in new tab adds one; each keeps its view.
size 1280 800
click-item sidebarNewNotebook
type Physics
key Return
expect-file Physics
right-click-item row_Physics
click-item menuNewPage
type Optics
key Return
expect-text pageTitle Optics
right-click-item row_Physics
click-item menuNewPage
type Waves
key Return
expect-text pageTitle Waves
expect-prop pageTab_Physics/Optics active false
click-item closePage
expect-text pageTitle Optics
# A single click opens a preview tab beside the open one; the next click reuses it.
click-item row_Physics/Waves
expect-text pageTitle Waves
expect-prop pageTab_Physics/Optics active false
expect-prop pageTab_Physics/Waves preview true
click-item closeTab_Physics/Optics
click-item row_Physics/Optics
expect-text pageTitle Optics
expect-hidden pageTab_Physics/Waves
expect-prop pageTab_Physics/Optics preview true
# Writing on a preview keeps it.
pen p=0.6 600,400 700,420
expect-prop pageTab_Physics/Optics preview false
right-click-item row_Physics/Waves
click-item menuOpenInNewTab
expect-text pageTitle Waves
expect-prop pageTab_Physics/Waves preview false
click-item pageTab_Physics/Optics
key Ctrl+=
expect-prop canvas zoom 1.25
click-item pageTab_Physics/Waves
expect-text pageTitle Waves
expect-prop canvas zoom 1
key Ctrl+PgUp
expect-text pageTitle Optics
expect-prop canvas zoom 1.25
shot tabs
# Renaming follows into the tab; closing the open tab shows the one beside it.
right-click-item row_Physics/Waves
click-item menuRename
key Ctrl+A
type Sound
key Return
expect-file Physics/Sound.svg
expect-prop pageTab_Physics/Sound active false
key Ctrl+W
expect-text pageTitle Sound
expect-hidden pageTab_Physics/Optics
# Closing every tab leaves no page open.
click-item closePage
click-item closePage
click-item closePage
expect-prop noPage visible true
# Recent keeps its order while the pointer is over the sidebar, so rows don't move under it.
click-item viewNotebooks
expect-prop recent_Physics/Optics index 3
click-item recent_Physics/Optics
expect-text pageTitle Optics
expect-prop recent_Physics/Optics index 3
click-item tab_draw
expect-prop recent_Physics/Optics index 0
