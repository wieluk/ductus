# A page closes; without one the pen writes nowhere and the hint starts a new page.
size 1280 800
expect-text pageTitle First page
click-item closePage
expect-prop canvas enabled false
expect-prop noPage visible true
expect-text pageTitle 
pen p=0.6 600,400 700,420
key Ctrl+S
expect-not-in-file My Notebook/First page.svg | dx:ink
click-item row_My Notebook/First page
expect-prop canvas enabled true
key Ctrl+W
expect-prop noPage visible true
click-item noPageNewPage
type Fresh start
key Return
expect-file Fresh start.svg
expect-text pageTitle Fresh start
