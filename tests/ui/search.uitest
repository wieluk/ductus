# Search: typed text, formulas, PDF text and recognized handwriting, opening at the match;
# Ctrl+F searches the open page, Ctrl+K all pages, and names alone on request.
size 1280 800
setenv DUCTUS_TEST_RECOGNIZER Grenzwert einer Folge
click-item tab_insert
click-item insertText
click 600,600
type Konvergenz einer Folge
key Escape
click-item tab_draw
click-item toolPen
pen p=0.6 420,300 440,280 460,310 480,285 500,305 520,282 540,300
wait 5000
expect-in-file My Notebook/First page.svg | Grenzwert einer Folge
import-pdf annotate tests/fixtures/lecture.pdf
click-item sidebarNewPage
key Escape
wait 1500
key Ctrl+F
expect-text searchScopeLabel This page
type vergenz
wait 400
expect-text searchStatus Nothing found.
key Ctrl+K
expect-text searchScopeLabel All pages
key Ctrl+A
type vergenz
wait 400
key Return
wait 300
expect-text pageTitle First page
key Ctrl+F
key Ctrl+A
type einer
wait 400
expect-prop searchResult1 visible true
key Return
key Return
expect-prop searchList visible true
key Ctrl+A
type first
wait 400
expect-text searchStatus Nothing found.
click-item searchScope_names
wait 400
expect-text searchScopeLabel Page names
expect-text searchResult0 First page
key Ctrl+A
type einer
wait 400
expect-text searchStatus Nothing found.
key Ctrl+K
expect-text searchScopeLabel Page names
key Ctrl+A
type lecture
wait 400
click-item searchScope_all
key Ctrl+A
type lecture 3
wait 400
click-item searchResult0
wait 300
expect-text pageTitle lecture
key Ctrl+K
key Ctrl+A
type grenzwert
wait 400
expect-prop searchResult0 visible true
key Escape
