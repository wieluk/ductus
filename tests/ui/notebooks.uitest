# Notebooks, pages, external changes and deleting, on an empty library.
size 1280 800
expect-file My Notebook/First page.svg
expect-text libraryLabel Notes
pen p=0.3-0.9 500,300 600,380 700,300 800,380 900,300
click-item sidebarNewNotebook
type Mathematics
key Return
expect-file Mathematics
right-click-item row_Mathematics
click-item menuNewPage
type Limits
key Return
expect-file Mathematics/Limits.svg
click-item tab_page
click-item page_a4
click-item pattern_lined
pen p=0.6 700,250 900,280
expect-in-file Mathematics/Limits.svg | dx:pattern="lined"
# Wide lines, below the heading room and with a margin line.
click-item spacing2
pen p=0.6 700,320 900,340
expect-in-file Mathematics/Limits.svg | dx:spacing="37.795"
expect-in-file Mathematics/Limits.svg | stroke-width="0.8"
shot lined
click-item row_My Notebook/First page
expect-text pageTitle First page
# A sync tool adds a page: the tree shows it.
copy-file Mathematics/Limits.svg | My Notebook/From phone.svg
wait 800
click-item row_My Notebook/From phone
expect-text pageTitle From phone
right-click-item row_Mathematics/Limits
click-item menuDelete
click-item confirmDelete
expect-no-file Mathematics/Limits.svg
# History and trash live in the app data, not in the library.
expect-no-file .ductus
expect-no-file .ductus.json
expect-no-file Mathematics/.ductus.json
# Sections: added below a notebook or beside a section, each with a first page.
click-item viewNotebooks
click-item addSection_Mathematics
type Algebra
key Return
expect-file Mathematics/Algebra/Untitled page.svg
expect-prop row_Mathematics/Algebra kind section
right-click-item row_Mathematics/Algebra
click-item menuNewFolder
type Analysis
key Return
expect-file Mathematics/Analysis/Untitled page.svg
# A section dropped onto another makes that a section group.
drag-item row_Mathematics/Analysis | row_Mathematics/Algebra
expect-file Mathematics/Algebra/Analysis/Untitled page.svg
expect-prop row_Mathematics/Algebra kind group
expect-prop row_Mathematics/Algebra/Analysis kind section
shot sections
# F2 renames the open page; dots in its name stay part of it.
key F2
type Lab 18.05.2026
key Return
expect-file My Notebook/Lab 18.05.2026.svg
click-item row_Mathematics/Algebra/Untitled page
click-item row_My Notebook/Lab 18.05.2026
expect-text pageTitle Lab 18.05.2026
