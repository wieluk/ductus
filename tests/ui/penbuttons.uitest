# A pen's side buttons and eraser end stand in for a tool while held, as chosen in the settings.
size 1280 800
pen p=0.6 400,300 700,300
# By default the side button erases.
pen button=1 550,250 550,350
key Ctrl+A
expect-prop canvas selectionCount 0
key Ctrl+Z
key Ctrl+A
expect-prop canvas selectionCount 1
key Escape
# Select all took the lasso.
click-item toolPen
# The second button lassoes, the first highlights; the chosen tool stays the pen.
click-item appMenuButton
click-item menuSettings
expect-prop penButtonTool displayText Eraser
click-item penButton2Tool
key Down
key Return
expect-prop penButton2Tool displayText Lasso
click-item penButtonTool
key Up
key Return
expect-prop penButtonTool displayText Highlighter
expect-prop eraserEndTool displayText Eraser
shot settings-pen-buttons
click-item settingsClose
pen button=2 350,250 750,250 750,350 350,350 350,250
expect-prop canvas selectionCount 1
expect-prop canvas tool Pen
key Escape
pen button=1 400,450 700,450
key Ctrl+A
expect-prop canvas selectionCount 2
key Escape
shot pen-buttons
# Held in the air, a side button or the eraser end shows its tool in the bars.
click-item toolPen
hover button=2 550,500
expect-prop canvas shownTool Lasso
expect-prop barTool_lasso active true
expect-prop canvas tool Pen
hover 550,500
expect-prop canvas shownTool Pen
expect-prop barTool_lasso active false
hover eraser 550,500
expect-prop barTool_eraser active true
pen-out
expect-prop canvas shownTool Pen
# A side button's click in the air draws nothing.
pen-click button=1 550,500
key Ctrl+A
expect-prop canvas selectionCount 2
key Escape
# Switching: a click changes the tool, and on that tool goes back.
click-item toolPen
click-item appMenuButton
click-item menuSettings
click-item penButtonsMode1
click-item settingsClose
pen-click button=1 550,500
expect-prop canvas tool Highlighter
pen-click button=1 550,500
expect-prop canvas tool Pen
# A side button the pen reports for a moment, at the edge of its range, is no click.
pen-click button=1 ms=10 550,500
wait 100
expect-prop canvas tool Pen
pen-click button=2 550,500
pen-click button=1 550,500
expect-prop canvas tool Highlighter
pen-click button=1 550,500
expect-prop canvas tool Pen
# A side button the pen reports for a moment, at the edge of its range, is no click.
pen-click button=1 ms=10 550,500
wait 100
expect-prop canvas tool Pen
pen-click button=2 550,500
expect-prop canvas tool Lasso
# A tool picked in the bar is the one to go back to.
click-item barTool_eraser
pen-click button=2 550,500
expect-prop canvas tool Lasso
pen-click button=2 550,500
expect-prop canvas tool Eraser
# A click the pen reports as it comes into range, or as it leaves, is none.
pen-out
hover 550,500
pen-click button=1 ms=90 550,500
wait 250
expect-prop canvas tool Eraser
wait 200
pen-click button=1 ms=75 550,500
pen-out
wait 250
expect-prop canvas tool Eraser
# A click and the tip right after: the stroke already has the clicked tool.
hover 550,500
wait 250
pen-click button=2 550,500
pen p=0.6 350,250 750,250 750,350 350,350 350,250
expect-prop canvas selectionCount 1
expect-prop canvas tool Lasso
